{
	"name": "blog",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"blog": "bun run cli/blog.ts",
		"blog:prod": "BLOG_API_URL=https://www.solberg.is bun run cli/blog.ts",
		"atlas": "./scripts/atlas-diff.sh",
		"dev": "vite dev",
		"build": "vite build && tsc --noEmit",
		"start": "vite preview",
		"test": "bun test",
		"deploy": "bun run build && wrangler deploy",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint -c .oxlintrc.json --type-aware --type-check --deny-warnings",
		"lint:fix": "oxlint -c .oxlintrc.json --type-aware --type-check --fix",
		"format-and-lint": "bun run lint && bun run format:check",
		"format-and-lint:fix": "bun run lint:fix && bun run format",
		"knip": "dotenvx run -- knip",
		"knip:fix": "dotenvx run -- knip --fix",
		"run:migration": "wrangler d1 execute solberg-blog --file",
		"postinstall": "lefthook install",
		"generate:migration": "drizzle-kit generate --config=drizzle-kit.config.ts",
		"studio": "drizzle-kit studio --config=drizzle-kit.config.ts",
		"gen:db-types": "bun run scripts/gen-db-types.ts"
	},
	"dependencies": {
		"@formisch/react": "^1.0.0-rc.0",
		"@headlessui/react": "^2.2.10",
		"@heroicons/react": "^2.2.0",
		"@monaco-editor/react": "^4.7.0",
		"@tanstack/highlight": "0.0.9",
		"@tanstack/markdown": "0.0.12",
		"@tanstack/react-pacer": "^0.22.1",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-start": "^1.168.33",
		"@vitejs/plugin-react": "^6.0.5",
		"arctic": "^3.7.0",
		"better-result": "^3.0.1",
		"clsx": "^2.1.1",
		"culori": "^4.0.2",
		"d3-array": "^3.2.4",
		"d3-interpolate": "^3.0.1",
		"d3-sankey": "^0.12.3",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"db-result": "^0.3.0",
		"diff": "^9.0.0",
		"drizzle-orm": "1.0.0-rc.4",
		"iron-session": "^8.0.4",
		"kysely": "^0.29.4",
		"kysely-d1": "^0.4.0",
		"monaco-editor": "^0.56.0",
		"motion": "^12.43.0",
		"react": "^19.2.8",
		"react-aria-components": "^1.19.0",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.2",
		"recharts": "^3.10.1",
		"remark-gfm": "^4.0.1",
		"remeda": "^2.39.0",
		"result-rpc": "github:jokull/result-rpc#experiment/wire-codec",
		"rss": "^1.2.2",
		"safe-mdx": "^1.11.5",
		"shiki": "^4.3.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss-react-aria-components": "^2.2.0",
		"takumi-js": "^2.5.4",
		"temporal-polyfill": "^1.0.3",
		"tw-animate-css": "^1.4.0",
		"usehooks-ts": "^3.1.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.49.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/d3-array": "^3.2.2",
		"@types/d3-interpolate": "^3.0.4",
		"@types/d3-sankey": "^0.12.5",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/mdx": "^2.0.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/rss": "^0.0.32",
		"@vitejs/plugin-rsc": "^0.5.32",
		"drizzle-kit": "1.0.0-rc.4",
		"knip": "^6.29.0",
		"lefthook": "^2.1.10",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.76.0",
		"oxlint-tsgolint": "^7.0.2001",
		"postcss": "^8.5.25",
		"react-server-dom-webpack": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"typescript-language-server": "^5.3.0",
		"vite": "^8.2.0",
		"wrangler": "^4.116.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild"
		]
	},
	"patchedDependencies": {}
}
