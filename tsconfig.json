{
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"paths": {
			"@/*": ["./*"],
			"ui": ["./components/ui"]
		},
		"target": "ES2017"
	},
	"include": ["**/*.ts", "**/*.tsx", ".cloudflare/types/index.d.ts"],
	"exclude": ["node_modules"]
}
